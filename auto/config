#!/bin/sh
# Called by `lb config`. Generates the live-build configuration.
set -e
. ./null-os.conf

# arm64 boots through UEFI only (no BIOS/isolinux) and uses Debian's
# generic arm64 kernel
case "$ARCH" in
  arm64) ARCH_OPTS="--bootloaders grub-efi --linux-flavours arm64" ;;
  *)     ARCH_OPTS="" ;;
esac

# shellcheck disable=SC2086
lb config noauto \
  --distribution "$DEBIAN_SUITE" \
  --architectures "$ARCH" \
  $ARCH_OPTS \
  --archive-areas "main contrib non-free non-free-firmware" \
  --binary-images iso-hybrid \
  --debian-installer none \
  --security true \
  --updates true \
  --apt-recommends false \
  --firmware-chroot true \
  --iso-application "$DISTRO_NAME" \
  --iso-volume "$(echo "$DISTRO_ID" | tr a-z A-Z)_$DISTRO_VERSION" \
  --iso-publisher "$DISTRO_NAME" \
  --bootappend-live "boot=live components hostname=$DISTRO_HOSTNAME username=user live-config.user-default-groups=audio,cdrom,dip,floppy,video,plugdev,netdev,sudo,wireshark persistence quiet splash" \
  "$@"
