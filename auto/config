#!/bin/sh
# Called by `lb config`. Generates the live-build configuration.
set -e
. ./null-os.conf

lb config noauto \
  --distribution "$DEBIAN_SUITE" \
  --architectures "$ARCH" \
  --archive-areas "main contrib non-free non-free-firmware" \
  --binary-images iso-hybrid \
  --debian-installer none \
  --security true \
  --updates true \
  --apt-recommends false \
  --firmware-chroot true \
  --iso-application "$DISTRO_NAME" \
  --iso-volume "$(echo "$DISTRO_ID" | tr a-z A-Z)_$DISTRO_VERSION" \
  --iso-publisher "$DISTRO_NAME" \
  --bootappend-live "boot=live components hostname=$DISTRO_HOSTNAME username=user live-config.user-default-groups=audio,cdrom,dip,floppy,video,plugdev,netdev,sudo,wireshark persistence quiet splash" \
  "$@"
