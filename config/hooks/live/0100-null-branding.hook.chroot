#!/bin/sh
# Runs inside the image during build. Applies Null OS branding, fonts, shell,
# Plasma defaults, boot splash and system settings. Values come from
# /etc/null-os-release, which build.sh generates from null-os.conf.
set -ex
. /etc/null-os-release

# ---- os-release (diverted so base-files upgrades don't overwrite it) ----
if ! dpkg-divert --list /usr/lib/os-release | grep -q null-os; then
  dpkg-divert --package null-os-branding --add --rename \
    --divert /usr/lib/os-release.debian /usr/lib/os-release
fi
. /usr/lib/os-release.debian
cat > /usr/lib/os-release <<OS
PRETTY_NAME="$NULL_NAME $NULL_VERSION (Debian $VERSION_ID based)"
NAME="$NULL_NAME"
VERSION_ID="$NULL_VERSION"
VERSION="$NULL_VERSION ($VERSION_CODENAME)"
VERSION_CODENAME=$VERSION_CODENAME
ID=$NULL_ID
ID_LIKE=debian
HOME_URL="https://github.com/Null0Grid/null-os"
SUPPORT_URL="https://github.com/Null0Grid/null-os/issues"
BUG_REPORT_URL="https://github.com/Null0Grid/null-os/issues"
LOGO=null-os
OS
printf '%s %s \\n \\l\n\n' "$NULL_NAME" "$NULL_VERSION" > /etc/issue
printf '%s %s\n' "$NULL_NAME" "$NULL_VERSION" > /etc/issue.net

# ---- Null Mono font (JetBrains Mono + the Null mark at U+E900) ----
mkdir -p /usr/share/fonts/truetype/null-mono
found=0
for f in $(find /usr/share/fonts -iname 'JetBrainsMono*.ttf' ! -path '*null-mono*'); do
  out="/usr/share/fonts/truetype/null-mono/$(basename "$f" | sed 's/JetBrainsMono/NullMono/')"
  python3 /usr/share/null-os/patch-font.py "$f" "$out"
  found=1
done
[ "$found" = 1 ] || { echo "ERROR: JetBrains Mono not found, cannot build Null Mono" >&2; exit 1; }
fc-cache -f >/dev/null

# ---- zsh as the default shell for everyone ----
sed -i 's|^#\?DSHELL=.*|DSHELL=/bin/zsh|' /etc/adduser.conf
sed -i 's|^SHELL=.*|SHELL=/bin/zsh|' /etc/default/useradd 2>/dev/null || echo 'SHELL=/bin/zsh' >> /etc/default/useradd
chsh -s /bin/zsh root
cp /etc/skel/.zshrc /root/.zshrc

# ---- Desktop-only settings ----
if [ -d /usr/share/plasma ]; then
  # Wallpaper, lock screen and login background via a desktop-base theme
  update-alternatives --install /usr/share/desktop-base/active-theme desktop-theme \
    /usr/share/desktop-base/nullos-theme 100
  update-alternatives --set desktop-theme /usr/share/desktop-base/nullos-theme

  # Icon cache for NullLine
  [ -d /usr/share/icons/NullLine ] && gtk-update-icon-cache -f -q /usr/share/icons/NullLine || true

  # Null Grid as the default browser
  NG=$(grep -lE '^Name=.*(Null Grid|NODE_GRID)' /usr/share/applications/*.desktop 2>/dev/null | head -1 || true)
  if [ -n "$NG" ]; then
    NG=$(basename "$NG")
    cat > /etc/xdg/mimeapps.list <<MIME
[Default Applications]
x-scheme-handler/http=$NG
x-scheme-handler/https=$NG
text/html=$NG
application/xhtml+xml=$NG
MIME
    printf '\n[General]\nBrowserApplication=%s\n' "$NG" >> /etc/xdg/kdeglobals
  fi

  # Flathub in Discover
  flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || true

  # Calamares: Null OS name on the installer and its launcher
  if [ -f /etc/calamares/branding/debian/branding.desc ]; then
    sed -i -E "s/^( *(productName|shortProductName|bootloaderEntryName): *).*/\1$NULL_NAME/; \
               s/^( *(version|shortVersion): *).*/\1$NULL_VERSION/; \
               s/^( *(versionedName|shortVersionedName): *).*/\1$NULL_NAME $NULL_VERSION/" \
      /etc/calamares/branding/debian/branding.desc
  fi
  for d in /usr/share/applications/install-debian.desktop /etc/skel/Desktop/install-debian.desktop; do
    [ -f "$d" ] && sed -i "s/^Name=.*/Name=Install $NULL_NAME/; s/^Name\[.*//" "$d"
  done

  # SDDM: Null OS logo instead of the Debian one
  for t in debian-breeze breeze; do
    [ -d /usr/share/sddm/themes/$t ] || continue
    printf '[General]\nshowlogo=shown\nlogo=/usr/share/null-os/sddm-logo.png\nbackground=/usr/share/desktop-base/nullos-theme/login/background.png\ntype=image\n' \
      > /usr/share/sddm/themes/$t/theme.conf.user
  done

  systemctl enable sddm NetworkManager 2>/dev/null || true
fi

# ---- Plymouth: glitch startup / CRT shutdown ----
if [ -d /usr/share/plymouth/themes/null ]; then
  plymouth-set-default-theme null
  update-initramfs -u -k all || true
fi

# ---- Firewall: block incoming except SSH (configured on first boot) ----
systemctl enable null-firewall-setup.service 2>/dev/null || true

# ---- Services and defaults ----
systemctl enable ssh chrony docker lldpd 2>/dev/null || true
sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config
echo 'unattended-upgrades unattended-upgrades/enable_auto_updates boolean true' | debconf-set-selections
dpkg-reconfigure -f noninteractive unattended-upgrades || true
# Note: don't set EXTRA_GROUPS in adduser.conf. A group that doesn't exist
# (wireshark is only created when dumpcap is setuid) makes adduser fail,
# which silently breaks creation of the live user. The live user gets its
# groups from live-config.user-default-groups instead.
groupadd -f wireshark

chmod +x /usr/local/bin/null-info
