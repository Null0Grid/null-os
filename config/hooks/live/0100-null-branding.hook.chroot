#!/bin/sh
# Runs inside the image during build. Applies branding from /etc/remix-release
# (generated by build.sh from remix.conf).
set -e
. /etc/remix-release

# Rebrand os-release the package-safe way: divert Debian's file so
# base-files upgrades don't overwrite ours.
if ! dpkg-divert --list /usr/lib/os-release | grep -q remix; then
  dpkg-divert --package remix-branding --add --rename \
    --divert /usr/lib/os-release.debian /usr/lib/os-release
fi
. /usr/lib/os-release.debian
cat > /usr/lib/os-release <<OS
PRETTY_NAME="$REMIX_NAME $REMIX_VERSION (based on Debian $VERSION_ID)"
NAME="$REMIX_NAME"
VERSION_ID="$REMIX_VERSION"
VERSION="$REMIX_VERSION ($VERSION_CODENAME)"
VERSION_CODENAME=$VERSION_CODENAME
ID=$REMIX_ID
ID_LIKE=debian
HOME_URL="https://www.debian.org/"
SUPPORT_URL="https://www.debian.org/support"
BUG_REPORT_URL="https://bugs.debian.org/"
OS

# Login banners
printf '%s %s \\n \\l\n\n' "$REMIX_NAME" "$REMIX_VERSION" > /etc/issue
printf '%s %s\n' "$REMIX_NAME" "$REMIX_VERSION" > /etc/issue.net

# Sensible defaults
systemctl enable ssh chrony docker lldpd 2>/dev/null || true
sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config
echo 'unattended-upgrades unattended-upgrades/enable_auto_updates boolean true' | debconf-set-selections
dpkg-reconfigure -f noninteractive unattended-upgrades || true

# Add the live user (and new users) to docker automatically
sed -i 's/^#\?EXTRA_GROUPS=.*/EXTRA_GROUPS="docker"/; s/^#\?ADD_EXTRA_GROUPS=.*/ADD_EXTRA_GROUPS=1/' /etc/adduser.conf

chmod +x /usr/local/bin/remix-info
