#!/bin/sh
# Runs inside the image during build. Applies Null OS branding, fonts, shell,
# Plasma defaults, boot splash and system settings. Values come from
# /etc/null-os-release, which build.sh generates from null-os.conf.
set -ex
. /etc/null-os-release

# ---- os-release (diverted so base-files upgrades don't overwrite it) ----
if ! dpkg-divert --list /usr/lib/os-release | grep -q null-os; then
  dpkg-divert --package null-os-branding --add --rename \
    --divert /usr/lib/os-release.debian /usr/lib/os-release
fi
. /usr/lib/os-release.debian
cat > /usr/lib/os-release <<OS
PRETTY_NAME="$NULL_NAME $NULL_VERSION (Debian $VERSION_ID based)"
NAME="$NULL_NAME"
VERSION_ID="$NULL_VERSION"
VERSION="$NULL_VERSION ($VERSION_CODENAME)"
VERSION_CODENAME=$VERSION_CODENAME
ID=$NULL_ID
ID_LIKE=debian
HOME_URL="https://github.com/Null0Grid/null-os"
SUPPORT_URL="https://github.com/Null0Grid/null-os/issues"
BUG_REPORT_URL="https://github.com/Null0Grid/null-os/issues"
LOGO=null-os
OS
printf '%s %s \\n \\l\n\n' "$NULL_NAME" "$NULL_VERSION" > /etc/issue
printf '%s %s\n' "$NULL_NAME" "$NULL_VERSION" > /etc/issue.net

# ---- Null Mono font (JetBrains Mono + the Null mark at U+E900) ----
mkdir -p /usr/share/fonts/truetype/null-mono
found=0
for f in $(find /usr/share/fonts -iname 'JetBrainsMono*.ttf' ! -path '*null-mono*'); do
  out="/usr/share/fonts/truetype/null-mono/$(basename "$f" | sed 's/JetBrainsMono/NullMono/')"
  python3 /usr/share/null-os/patch-font.py "$f" "$out"
  found=1
done
[ "$found" = 1 ] || { echo "ERROR: JetBrains Mono not found, cannot build Null Mono" >&2; exit 1; }
fc-cache -f >/dev/null

# ---- zsh as the default shell for everyone ----
sed -i 's|^#\?DSHELL=.*|DSHELL=/bin/zsh|' /etc/adduser.conf
sed -i 's|^SHELL=.*|SHELL=/bin/zsh|' /etc/default/useradd 2>/dev/null || echo 'SHELL=/bin/zsh' >> /etc/default/useradd
chsh -s /bin/zsh root
cp /etc/skel/.zshrc /root/.zshrc

# ---- Desktop-only settings ----
if [ -d /usr/share/plasma ]; then
  # Wallpaper, lock screen and login background via a desktop-base theme
  update-alternatives --install /usr/share/desktop-base/active-theme desktop-theme \
    /usr/share/desktop-base/nullos-theme 100
  update-alternatives --set desktop-theme /usr/share/desktop-base/nullos-theme

  # Icon caches (NullLine theme, null-os logo in hicolor)
  [ -d /usr/share/icons/NullLine ] && gtk-update-icon-cache -f -q /usr/share/icons/NullLine || true
  gtk-update-icon-cache -f -q /usr/share/icons/hicolor || true

  # Null OS look-and-feel: Breeze Dark's layouts with Null OS defaults.
  # Plasma applies the default look-and-feel's settings on first login,
  # which would otherwise override /etc/xdg with Breeze colors, icons and
  # the stock wallpaper.
  LNF=/usr/share/plasma/look-and-feel
  if [ -d $LNF/org.kde.breezedark.desktop ]; then
    rm -rf $LNF/org.nullos.desktop
    cp -a $LNF/org.kde.breezedark.desktop $LNF/org.nullos.desktop
    python3 - <<'PY'
import json
p = "/usr/share/plasma/look-and-feel/org.nullos.desktop/metadata.json"
m = json.load(open(p))
k = m.setdefault("KPlugin", {})
k["Id"] = "org.nullos.desktop"
k["Name"] = "Null OS"
k["Description"] = "Null OS: Neon Lab colors, NullLine icons, Null OS wallpaper"
for key in list(k):
    if key.startswith(("Name[", "Description[")):
        del k[key]
k["Authors"] = [{"Name": "Null Grid"}]
json.dump(m, open(p, "w"), indent=2)
PY
    cat > $LNF/org.nullos.desktop/contents/defaults <<'DEF'
[kcminputrc][Mouse]
cursorTheme=breeze_cursors

[kdeglobals][General]
ColorScheme=NullLab

[kdeglobals][Icons]
Theme=NullLine

[kdeglobals][KDE]
widgetStyle=Breeze

[kwinrc][org.kde.kdecoration2]
library=org.kde.breeze
theme=Breeze

[plasmarc][Theme]
name=breeze-dark

[Wallpaper]
Image=NullOS
DEF
  fi

  # Fallback: anything still pointing at Plasma's stock "Next" wallpaper
  # (lock screen, new desktops) shows the Null OS wallpaper instead.
  if [ -d /usr/share/wallpapers/Next ]; then
    find /usr/share/wallpapers/Next -type f \( -name '*.png' -o -name '*.jpg' -o -name '*.jxl' -o -name '*.webp' \) | while read -r f; do
      dpkg-divert --package null-os-branding --add --rename --divert "$f.plasma" "$f" >/dev/null
      cp /usr/share/wallpapers/NullOS/contents/images/1920x1080.png "$f"
    done
  fi

  # Null Grid as the default browser
  NG=$(grep -lE '^Name=.*(Null Grid|NODE_GRID)' /usr/share/applications/*.desktop 2>/dev/null | head -1 || true)
  if [ -n "$NG" ]; then
    NG=$(basename "$NG")
    cat > /etc/xdg/mimeapps.list <<MIME
[Default Applications]
x-scheme-handler/http=$NG
x-scheme-handler/https=$NG
text/html=$NG
application/xhtml+xml=$NG
MIME
    printf '\n[General]\nBrowserApplication=%s\n' "$NG" >> /etc/xdg/kdeglobals
  fi

  # Null File as the default file manager (folders, "open folder", taskbar)
  NF=$(grep -lE '^Exec=.*null-file' /usr/share/applications/*.desktop 2>/dev/null | head -1 || true)
  if [ -n "$NF" ]; then
    NF=$(basename "$NF")
    touch /etc/xdg/mimeapps.list
    grep -q '^\[Default Applications\]' /etc/xdg/mimeapps.list || printf '[Default Applications]\n' >> /etc/xdg/mimeapps.list
    sed -i "/^\[Default Applications\]/a inode/directory=$NF" /etc/xdg/mimeapps.list
  else
    echo "WARNING: Null File not installed; no default file manager set" >&2
  fi

  # Flathub in Discover
  flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || true

  # Calamares: Null OS name on the installer and its launcher
  if [ -f /etc/calamares/branding/debian/branding.desc ]; then
    sed -i -E "s/^( *(productName|shortProductName|bootloaderEntryName): *).*/\1$NULL_NAME/; \
               s/^( *(version|shortVersion): *).*/\1$NULL_VERSION/; \
               s/^( *(versionedName|shortVersionedName): *).*/\1$NULL_NAME $NULL_VERSION/" \
      /etc/calamares/branding/debian/branding.desc
  fi
  # Installer users page: offer an "accept weak password" checkbox (unchecked)
  UC=/etc/calamares/modules/users.conf
  if [ ! -f $UC ] && [ -f /usr/share/calamares/modules/users.conf ]; then
    mkdir -p /etc/calamares/modules
    cp /usr/share/calamares/modules/users.conf $UC
  fi
  if [ -f $UC ]; then
    sed -i -E '/^allowWeakPasswords(Default)?:/d' $UC
    printf '\nallowWeakPasswords: true\nallowWeakPasswordsDefault: false\n' >> $UC
  else
    echo "WARNING: $UC not found; installer password settings unchanged" >&2
  fi
  # The password check needs cracklib's dictionary
  [ -e /var/cache/cracklib/cracklib_dict.pwd ] || update-cracklib || true
  # Installer "Apps" page: Minimal or Full (null-extras groups). The package
  # step moves after sources-final so Full downloads from the internet; Debian
  # runs it while apt still points at the USB stick.
  SC=/etc/calamares/settings.conf
  if [ -f $SC ] && [ -x /usr/local/bin/null-extras ]; then
    /usr/local/bin/null-extras netinstall-conf > /etc/calamares/modules/netinstall.conf
    grep -q -- '- netinstall' $SC || sed -i 's/^\( *\)- summary$/\1- netinstall\n\1- summary/' $SC
    if grep -q '^ *- sources-final$' $SC; then
      sed -i '/^ *- packages$/d' $SC
      sed -i 's/^\( *\)- sources-final$/\1- sources-final\n\1- packages/' $SC
    fi
    echo "Calamares sequence:"; sed -n '/^sequence:/,/^branding/p' $SC
  else
    echo "WARNING: Calamares settings or null-extras missing; no Apps page" >&2
  fi
  # Every "Install Debian" launcher (menu, desktop, autostart), whatever its file name
  for d in $(grep -rlE '^Name=Install Debian' /usr/share/applications /etc/skel /etc/xdg 2>/dev/null); do
    sed -i -E "s/^Name=.*/Name=Install $NULL_NAME/; /^Name\[/d; s/^Comment=.*/Comment=Install $NULL_NAME to this computer/; /^Comment\[/d" "$d"
  done

  # SDDM: Null OS logo instead of the Debian one
  for t in debian-breeze breeze; do
    [ -d /usr/share/sddm/themes/$t ] || continue
    printf '[General]\nshowlogo=shown\nlogo=/usr/share/null-os/sddm-logo.png\nbackground=/usr/share/desktop-base/nullos-theme/login/background.png\ntype=image\n' \
      > /usr/share/sddm/themes/$t/theme.conf.user
  done

  systemctl enable sddm NetworkManager 2>/dev/null || true
fi

# ---- Plymouth: glitch startup / CRT shutdown ----
if [ -d /usr/share/plymouth/themes/null ]; then
  plymouth-set-default-theme null
  update-initramfs -u -k all || true
fi

# ---- Firewall: block incoming except SSH (configured on first boot) ----
systemctl enable null-firewall-setup.service 2>/dev/null || true

# ---- Services and defaults ----
systemctl enable ssh chrony lldpd 2>/dev/null || true
sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config
echo 'unattended-upgrades unattended-upgrades/enable_auto_updates boolean true' | debconf-set-selections
dpkg-reconfigure -f noninteractive unattended-upgrades || true
# Note: don't set EXTRA_GROUPS in adduser.conf. A group that doesn't exist
# (wireshark is only created when dumpcap is setuid) makes adduser fail,
# which silently breaks creation of the live user. The live user gets its
# groups from live-config.user-default-groups instead.
groupadd -r -f wireshark

chmod +x /usr/local/bin/null-info

# ---- Keep UID/GID 1000 free for the first real user ----
# live-config (and Calamares) create the first user as 1000:1000. If any
# package or step above took 1000, user creation fails and nobody can log in.
g=$(getent group 1000 | cut -d: -f1 || true)
if [ -n "$g" ]; then
  newgid=$(awk -F: 'BEGIN{for(i=999;i>100;i--)u[i]=1} {delete u[$3]} END{for(i=999;i>100;i--) if(i in u){print i; exit}}' /etc/group)
  echo "Moving group $g off GID 1000 to $newgid"
  groupmod -g "$newgid" "$g"
fi
u=$(getent passwd 1000 | cut -d: -f1 || true)
if [ -n "$u" ]; then
  newuid=$(awk -F: 'BEGIN{for(i=999;i>100;i--)u[i]=1} {delete u[$3]} END{for(i=999;i>100;i--) if(i in u){print i; exit}}' /etc/passwd)
  echo "Moving user $u off UID 1000 to $newuid"
  usermod -u "$newuid" "$u"
fi
