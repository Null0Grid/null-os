// Null OS default fastfetch config. Copy to ~/.config/fastfetch/ to change it.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/null-os/fastfetch-logo.txt",
    "color": { "1": "38;2;0;229;255" },
    "padding": { "top": 1, "left": 1, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;0;229;255", "title": "38;2;255;46;136" }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "OS" },
    {
      "type": "command",
      "key": "Base",
      "text": ". /usr/lib/os-release.debian 2>/dev/null && echo \"$PRETTY_NAME\" || echo Debian"
    },
    "kernel",
    "uptime",
    "packages",
    "shell",
    "de",
    "wm",
    "theme",
    "icons",
    "font",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "localip",
    "break",
    "colors"
  ]
}
