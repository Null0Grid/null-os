#!/bin/sh
# live-config component: runs only when booting the live image, never on an
# installed system. Logs the live user straight into Plasma.
USER_NAME=$(sed -n 's/.*username=\([^ ]*\).*/\1/p' /proc/cmdline)
USER_NAME=${USER_NAME:-user}
mkdir -p /etc/sddm.conf.d
SESSION=plasma.desktop
[ -f /usr/share/wayland-sessions/plasma.desktop ] || SESSION=plasmax11.desktop
cat > /etc/sddm.conf.d/50-null-live-autologin.conf <<CONF
[Autologin]
User=$USER_NAME
Session=$SESSION
Relogin=false
CONF

# No automatic screen lock in the live session (nobody knows a password
# there). Super+L still locks; installed systems keep Plasma's default.
HOME_DIR=$(getent passwd "$USER_NAME" | cut -d: -f6)
if [ -n "$HOME_DIR" ] && [ -d "$HOME_DIR" ]; then
  mkdir -p "$HOME_DIR/.config"
  cat > "$HOME_DIR/.config/kscreenlockerrc" <<CONF
[Daemon]
Autolock=false
LockOnResume=false
CONF
  chown -R "$USER_NAME:" "$HOME_DIR/.config"
fi
