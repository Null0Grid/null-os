#!/bin/sh
# Null OS system summary
. /etc/os-release
echo "$PRETTY_NAME"
echo "Host:    $(hostname)   Kernel: $(uname -r)"
echo "Uptime:  $(uptime -p)"
echo "CPU:     $(nproc) cores - $(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2 | sed 's/^ //')"
echo "Memory:  $(free -h | awk '/Mem:/ {print $3 " used / " $2}')"
echo "Disk /:  $(df -h / | awk 'NR==2 {print $3 " used / " $2}')"
echo "Addrs:"
ip -br -4 addr show | grep -v '^lo' | sed 's/^/         /'
